{
  "version": 2,
  "builds": [
    {
      "src": "server.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "lead-magnet/**"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.ts" },
    { "src": "/lead-magnet/(.*)", "dest": "/server.ts" },
    { "src": "/lead-magnet", "dest": "/server.ts" },
    { "src": "/admin", "dest": "/server.ts" },
    { "src": "/admin/(.*)", "dest": "/server.ts" },
    { "src": "/(.*)", "dest": "/server.ts" }
  ]
}
